{
  "class": "chest",
  "version": 1,
  "family": "props",
  "means": "a treasure chest: a box base with bands and a lock plate, and a barrel-vault lid on hinges at the back that opens up and over",
  "source": "our own proportions for a chunky toon treasure chest (about 0.9 m wide); the lid is a cylinder segment of height h over the base's depth, radius (h^2 + (D/2)^2) / 2h",
  "default_style": "toon_chunky",
  "view": { "distance_m": 5.0, "typical": ["three_quarter", "front", "side"] },
  "measures": {
    "base.width": { "default": 0.9, "min": 0.6, "max": 0.98, "step": 0.06, "means": "base width (left to right)" },
    "base.depth": { "default": 0.56, "min": 0.4, "max": 0.6, "step": 0.04, "means": "base depth (front to back)" },
    "base.height": { "default": 0.42, "min": 0.3, "max": 0.46, "step": 0.04, "means": "base height" },
    "base.roundness": { "default": 1.0, "min": 0.3, "max": 2.0, "step": 0.4, "means": "edge rounding of the base" },
    "lid.height": { "default": 0.19, "min": 0.1, "max": 0.24, "step": 0.03, "means": "height of the lid's vault" },
    "bands.count": { "default": 2, "min": 1, "max": 3, "step": 1, "count": true, "means": "metal bands round base and lid" },
    "bands.width": { "default": 0.06, "min": 0.04, "max": 0.09, "step": 0.012, "means": "band width" },
    "bands.proud": { "default": 0.012, "min": 0.008, "max": 0.02, "step": 0.004, "means": "how far the bands stand out" },
    "lock.scale": { "default": 1.0, "min": 0.7, "max": 1.4, "step": 0.12, "means": "lock plate size" }
  },
  "parts": [
    { "name": "base", "role": "body", "solid": "base", "gen": "rounded_box",
      "params": { "size": ["base.width", "base.height", "base.depth"], "bevel": "0.03 * base.roundness" },
      "anchors": { "lid_hinge": { "at": ["0", "base.height / 2 + 0.011", "-base.depth / 2 - 0.03"], "n": ["-1", "0", "0"] } },
      "at": ["0", "base.height / 2", "0"] },
    { "name": "base_bands", "role": "trim", "solid": "base", "gen": "rounded_box", "group": "bands",
      "count": "bands.count", "spread": "base.width * 0.55 / max(1, bands.count - 1)", "spread_axis": "x",
      "params": { "size": ["bands.width", "base.height", "base.depth + 2 * bands.proud"], "bevel": "0.006" },
      "at": ["0", "base.height / 2", "0"] },
    { "name": "hinges", "role": "trim", "solid": "base", "gen": "rounded_box", "mirror": "x",
      "params": { "size": ["0.08", "0.07", "0.03"], "bevel": "0.008" },
      "at": ["base.width / 3", "base.height - 0.035", "-base.depth / 2 - 0.01"] },
    { "name": "hinge_pins", "role": "trim", "solid": "base", "gen": "cylinder", "mirror": "x",
      "params": { "radius": "0.018", "length": "0.08", "axis": "x", "bevel": "0.005" },
      "at": ["base.width / 3", "base.height + 0.011", "-base.depth / 2 - 0.03"] },
    { "name": "lock", "role": "trim", "solid": "base", "gen": "rounded_box",
      "params": { "size": ["0.12 * lock.scale", "0.14 * lock.scale", "0.026"], "bevel": "0.008" },
      "at": ["0", "base.height - 0.1 * lock.scale", "base.depth / 2 + 0.007"] },
    { "name": "lid", "role": "body", "solid": "lid", "gen": "cylinder",
      "params": { "radius": "(lid.height * lid.height + base.depth * base.depth / 4) / (2 * lid.height)", "length": "base.width", "axis": "x", "bevel": "0.03" },
      "at": ["0", "base.height + 0.022 + lid.height - (lid.height * lid.height + base.depth * base.depth / 4) / (2 * lid.height)", "0"] },
    { "name": "lid_bands", "role": "trim", "solid": "lid", "gen": "cylinder", "group": "bands",
      "count": "bands.count", "spread": "base.width * 0.55 / max(1, bands.count - 1)", "spread_axis": "x",
      "params": { "radius": "(lid.height * lid.height + base.depth * base.depth / 4) / (2 * lid.height) + bands.proud", "length": "bands.width", "axis": "x", "bevel": "0.005" },
      "at": ["0", "base.height + 0.022 + lid.height - (lid.height * lid.height + base.depth * base.depth / 4) / (2 * lid.height)", "0"] },
    { "name": "lid_cut", "role": "body", "solid": "lid", "gen": "rounded_box", "op": "cut",
      "params": { "size": ["base.width + 0.2", "2", "2"], "bevel": "0" },
      "at": ["0", "base.height + 0.022 - 1", "0"] }
  ],
  "groups": { "bands": ["base_bands", "lid_bands"] },
  "variants": {
    "lid.shape": { "dome": {}, "flat": { "set": { "lid.height": 0.1 } } },
    "lock.shape": { "plate": {} }
  },
  "counts": { "bands.count": "bands.count" },
  "anchors": [ { "name": "lid_hinge", "at": "base.lid_hinge" }, { "name": "lock", "at": "lock.front" } ],
  "clip_floor": true,
  "musts": { "connected": true, "stands": "ground", "symmetric": "x" },
  "collision": { "footprint": "box" }
}
