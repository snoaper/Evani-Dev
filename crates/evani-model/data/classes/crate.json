{
  "class": "crate",
  "version": 1,
  "family": "props",
  "means": "a wooden supply crate: a cube body, slats across every side and a brace on each vertical corner",
  "source": "our own proportions for a chunky toon crate (about 0.9 m)",
  "default_style": "toon_chunky",
  "view": { "distance_m": 5.0, "typical": ["three_quarter", "front", "top"] },
  "measures": {
    "body.size": { "default": 0.84, "min": 0.6, "max": 0.88, "step": 0.06, "means": "cube side" },
    "body.roundness": { "default": 1.0, "min": 0.3, "max": 2.0, "step": 0.4, "means": "edge rounding of the body" },
    "slats.count": { "default": 3, "min": 1, "max": 5, "step": 1, "count": true, "means": "slats per side" },
    "slats.thick": { "default": 0.04, "min": 0.025, "max": 0.06, "step": 0.008, "means": "slat thickness (how far they stand out)" },
    "slats.fill": { "default": 0.6, "min": 0.4, "max": 0.8, "step": 0.08, "means": "share of each slat's pitch the board covers" },
    "corner_braces.thick": { "default": 0.07, "min": 0.05, "max": 0.1, "step": 0.012, "means": "corner brace size" }
  },
  "parts": [
    { "name": "body", "role": "body", "solid": "body", "gen": "rounded_box",
      "params": { "size": ["body.size", "body.size", "body.size"], "bevel": "0.04 * body.roundness" },
      "at": ["0", "body.size / 2", "0"] },
    { "name": "slats_front", "role": "trim", "solid": "body", "gen": "rounded_box", "group": "slats",
      "count": "slats.count", "spread": "body.size / slats.count", "spread_axis": "y",
      "params": { "size": ["body.size * 0.96", "slats.fill * body.size / slats.count", "slats.thick + 0.01"], "bevel": "0.4 * slats.thick" },
      "at": ["0", "body.size / 2", "body.size / 2 + slats.thick / 2 - 0.005"] },
    { "name": "slats_back", "role": "trim", "solid": "body", "gen": "rounded_box", "group": "slats",
      "count": "slats.count", "spread": "body.size / slats.count", "spread_axis": "y",
      "params": { "size": ["body.size * 0.96", "slats.fill * body.size / slats.count", "slats.thick + 0.01"], "bevel": "0.4 * slats.thick" },
      "at": ["0", "body.size / 2", "-(body.size / 2 + slats.thick / 2 - 0.005)"] },
    { "name": "slats_side", "role": "trim", "solid": "body", "gen": "rounded_box", "group": "slats", "mirror": "x",
      "count": "slats.count", "spread": "body.size / slats.count", "spread_axis": "y",
      "params": { "size": ["slats.thick + 0.01", "slats.fill * body.size / slats.count", "body.size * 0.96"], "bevel": "0.4 * slats.thick" },
      "at": ["body.size / 2 + slats.thick / 2 - 0.005", "body.size / 2", "0"] },
    { "name": "corner_braces", "role": "trim", "solid": "body", "gen": "rounded_box", "mirror": "x",
      "count": "2", "spread": "body.size", "spread_axis": "z",
      "params": { "size": ["corner_braces.thick", "body.size", "corner_braces.thick"], "bevel": "0.3 * corner_braces.thick" },
      "at": ["body.size / 2", "body.size / 2", "0"] }
  ],
  "groups": { "slats": ["slats_front", "slats_back", "slats_side"] },
  "variants": {},
  "counts": { "slats.count": "slats.count" },
  "anchors": [ { "name": "top", "at": "body.top" } ],
  "musts": { "connected": true, "stands": "ground", "symmetric": "x" },
  "collision": { "footprint": "box" }
}
