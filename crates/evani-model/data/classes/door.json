{
  "class": "door",
  "version": 1,
  "family": "props",
  "means": "a plank door in its frame: the leaf hangs on the +x jamb and swings forward; plank grooves on the front, Z braces on the back, strap hinges and a ring handle",
  "source": "our own proportions for a chunky toon cottage door (about 1.2 m by 2.25 m)",
  "default_style": "toon_chunky",
  "view": { "distance_m": 6.0, "typical": ["front", "three_quarter", "back"] },
  "measures": {
    "frame.width": { "default": 1.2, "min": 0.9, "max": 1.3, "step": 0.06, "means": "outside width of the frame" },
    "frame.height": { "default": 2.25, "min": 1.9, "max": 2.3, "step": 0.08, "means": "outside height of the frame" },
    "frame.thick": { "default": 0.1, "min": 0.07, "max": 0.14, "step": 0.015, "means": "jamb and lintel thickness" },
    "frame.depth": { "default": 0.16, "min": 0.12, "max": 0.2, "step": 0.02, "means": "frame depth (front to back)" },
    "leaf.thick": { "default": 0.05, "min": 0.04, "max": 0.07, "step": 0.01, "means": "leaf thickness" },
    "leaf.planks": { "default": 5, "min": 2, "max": 8, "step": 1, "count": true, "means": "planks across the leaf (grooves between them)" },
    "leaf.braces": { "default": 1, "min": 0, "max": 1, "step": 0, "count": true, "means": "1 for Z braces on the back, 0 for none" },
    "hinges.count": { "default": 2, "min": 1, "max": 3, "step": 1, "count": true, "means": "strap hinges" },
    "hinges.size": { "default": 1.0, "min": 0.8, "max": 1.4, "step": 0.15, "means": "strap hinge size" }
  },
  "parts": [
    { "name": "frame", "role": "body", "solid": "frame", "gen": "frame",
      "params": { "size": ["frame.width", "frame.height"], "thickness": "frame.thick", "depth": "frame.depth", "bevel": "0.2 * frame.thick" },
      "at": ["0", "frame.height / 2", "0"] },
    { "name": "leaf", "role": "body", "solid": "leaf", "gen": "rounded_box",
      "params": { "size": ["frame.width - 2 * frame.thick - 0.06", "frame.height - 2 * frame.thick - 0.06", "leaf.thick"], "bevel": "0.01" },
      "at": ["0", "frame.height / 2", "frame.depth / 2 - 0.04 - leaf.thick / 2"] },
    { "name": "grooves", "role": "detail", "solid": "leaf", "gen": "rounded_box", "op": "cut",
      "count": "leaf.planks - 1", "spread": "(frame.width - 2 * frame.thick - 0.06) / leaf.planks", "spread_axis": "x",
      "params": { "size": ["0.024", "frame.height - 2 * frame.thick - 0.14", "0.04"], "bevel": "0.006" },
      "at": ["0", "frame.height / 2", "frame.depth / 2 - 0.04"] },
    { "name": "battens", "role": "body", "solid": "leaf", "gen": "rounded_box", "group": "braces",
      "count": "2 * leaf.braces", "spread": "(frame.height - 2 * frame.thick) * 0.62", "spread_axis": "y",
      "params": { "size": ["frame.width - 2 * frame.thick - 0.12", "0.12", "0.03"], "bevel": "0.01" },
      "at": ["0", "frame.height / 2", "frame.depth / 2 - 0.04 - leaf.thick - 0.01"] },
    { "name": "diagonal", "role": "body", "solid": "leaf", "gen": "tube", "group": "braces",
      "count": "leaf.braces",
      "params": { "radius": "0.024", "points": [
        "frame.width / 2 - frame.thick - 0.1", "-(frame.height - 2 * frame.thick) * 0.31 + 0.03", "0",
        "-(frame.width / 2 - frame.thick - 0.1)", "(frame.height - 2 * frame.thick) * 0.31 - 0.03", "0"
      ] },
      "at": ["0", "frame.height / 2", "frame.depth / 2 - 0.04 - leaf.thick - 0.008"] },
    { "name": "hinges", "role": "detail", "solid": "leaf", "gen": "rounded_box",
      "count": "hinges.count", "spread": "(frame.height - 2 * frame.thick) * 0.7 / max(1, hinges.count - 1)", "spread_axis": "y",
      "params": { "size": ["0.15", "0.06 * hinges.size", "0.024"], "bevel": "0.005" },
      "at": ["frame.width / 2 - frame.thick - 0.03 - 0.085", "frame.height / 2", "frame.depth / 2 - 0.04 + 0.006"] },
    { "name": "handle_mount", "role": "detail", "solid": "leaf", "gen": "cylinder",
      "params": { "radius": "0.024", "length": "0.05", "axis": "z", "bevel": "0.006" },
      "at": ["-(frame.width / 2 - frame.thick - 0.018) + 0.09", "frame.height * 0.47 + 0.05", "frame.depth / 2 - 0.04 + 0.0175"] },
    { "name": "handle", "role": "detail", "solid": "leaf", "gen": "tube",
      "params": { "radius": "0.014", "points": [
        "0", "0.05", "0",
        "0.01913", "0.04619", "0",
        "0.03536", "0.03536", "0",
        "0.04619", "0.01913", "0",
        "0.05", "0", "0",
        "0.04619", "-0.01913", "0",
        "0.03536", "-0.03536", "0",
        "0.01913", "-0.04619", "0",
        "0", "-0.05", "0",
        "-0.01913", "-0.04619", "0",
        "-0.03536", "-0.03536", "0",
        "-0.04619", "-0.01913", "0",
        "-0.05", "0", "0",
        "-0.04619", "0.01913", "0",
        "-0.03536", "0.03536", "0",
        "-0.01913", "0.04619", "0",
        "0", "0.05", "0"
      ] },
      "anchors": { "centre": { "at": ["0", "0", "0"], "n": ["0", "0", "1"] } },
      "at": ["-(frame.width / 2 - frame.thick - 0.018) + 0.09", "frame.height * 0.47", "frame.depth / 2 - 0.04 + 0.03"] }
  ],
  "groups": { "braces": ["battens", "diagonal"] },
  "variants": {
    "handle.shape": { "ring": {} }
  },
  "counts": { "leaf.planks": "leaf.planks", "hinges.count": "hinges.count" },
  "anchors": [ { "name": "handle", "at": "handle.centre" }, { "name": "hinge", "at": "frame.hinge" } ],
  "musts": { "connected": true, "stands": "ground" },
  "collision": { "footprint": "box" }
}
