{
  "class": "fence",
  "version": 1,
  "family": "props",
  "means": "a picket fence section: two posts with caps, rails between them and pickets nailed to the front of the rails",
  "source": "our own proportions for a chunky toon picket fence (about 2.3 m wide, 1.07 m tall)",
  "default_style": "toon_chunky",
  "view": { "distance_m": 7.0, "typical": ["front", "three_quarter", "side"] },
  "measures": {
    "posts.size": { "default": 0.11, "min": 0.08, "max": 0.14, "step": 0.015, "means": "post thickness" },
    "posts.height": { "default": 0.97, "min": 0.7, "max": 1.2, "step": 0.06, "means": "post height (without the cap)" },
    "posts.count": { "default": 2, "min": 2, "max": 2, "step": 0, "count": true, "means": "posts (a mirrored pair)" },
    "posts.cap": { "default": 1, "min": 0, "max": 1, "step": 0, "count": true, "means": "1 for a rounded cap on each post, 0 for none" },
    "rails.length": { "default": 2.15, "min": 1.2, "max": 2.4, "step": 0.1, "means": "distance between the post centres" },
    "rails.count": { "default": 2, "min": 1, "max": 3, "step": 1, "count": true, "means": "number of rails" },
    "rails.height": { "default": 0.07, "min": 0.05, "max": 0.1, "step": 0.01, "means": "rail height" },
    "rails.thick": { "default": 0.04, "min": 0.03, "max": 0.06, "step": 0.008, "means": "rail thickness" },
    "pickets.count": { "default": 7, "min": 3, "max": 12, "step": 1, "count": true, "means": "number of pickets" },
    "pickets.width": { "default": 0.11, "min": 0.07, "max": 0.14, "step": 0.012, "means": "picket width" },
    "pickets.height": { "default": 0.82, "min": 0.6, "max": 0.95, "step": 0.05, "means": "picket height (without its tip)" },
    "pickets.uneven": { "default": 0.0, "min": 0.0, "max": 0.05, "step": 0, "fit": false, "means": "random up and down shift of each picket" },
    "pickets.tips": { "default": 1, "min": 0, "max": 1, "step": 0, "count": true, "means": "1 for pointed tips, 0 for flat tops" }
  },
  "parts": [
    { "name": "posts", "role": "body", "solid": "body", "gen": "rounded_box", "mirror": "x",
      "params": { "size": ["posts.size", "posts.height", "posts.size"], "bevel": "0.2 * posts.size" },
      "at": ["rails.length / 2", "posts.height / 2", "0"] },
    { "name": "caps", "role": "trim", "solid": "body", "gen": "ellipsoid", "mirror": "x",
      "count": "posts.cap",
      "params": { "size": ["posts.size * 1.3", "0.11", "posts.size * 1.3"] },
      "at": ["rails.length / 2", "posts.height + 0.035", "0"] },
    { "name": "rails", "role": "body", "solid": "body", "gen": "rounded_box",
      "count": "rails.count", "spread": "0.42", "spread_axis": "y",
      "params": { "size": ["rails.length", "rails.height", "rails.thick"], "bevel": "0.3 * rails.thick" },
      "at": ["0", "0.1 + pickets.height / 2", "0"] },
    { "name": "pickets", "role": "body", "solid": "body", "gen": "rounded_box",
      "count": "pickets.count", "spread": "(rails.length - posts.size) / pickets.count", "spread_axis": "x",
      "jitter": ["0", "pickets.uneven", "0"],
      "params": { "size": ["pickets.width", "pickets.height", "0.025"], "bevel": "0.008" },
      "at": ["0", "0.1 + pickets.height / 2", "rails.thick / 2 + 0.0075"] },
    { "name": "picket_tips", "role": "trim", "solid": "body", "gen": "rounded_box",
      "count": "pickets.count * pickets.tips", "spread": "(rails.length - posts.size) / pickets.count", "spread_axis": "x",
      "jitter": ["0", "pickets.uneven", "0"], "jitter_with": "pickets",
      "params": { "size": ["pickets.width * 0.7071", "pickets.width * 0.7071", "0.025"], "bevel": "0.006" },
      "rot": ["0", "0", "45"],
      "at": ["0", "0.1 + pickets.height", "rails.thick / 2 + 0.0075"] }
  ],
  "groups": {},
  "variants": {},
  "counts": { "posts.count": "posts.count", "rails.count": "rails.count", "pickets.count": "pickets.count" },
  "anchors": [ { "name": "top", "at": "posts.top" } ],
  "musts": { "connected": true, "stands": "ground" },
  "collision": { "footprint": "box" }
}
