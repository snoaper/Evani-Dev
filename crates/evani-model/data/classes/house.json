{
  "class": "house",
  "version": 1,
  "family": "structures",
  "means": "a small cottage: four walls (optionally leaning in), a gable roof with overhanging eaves and a ridge, a chimney, an arched front door on the gable end and windows along one side",
  "source": "our own proportions for a chunky toon cottage (about 5 m by 6 m on the ground, under 6 m tall)",
  "default_style": "toon_chunky",
  "view": { "distance_m": 20, "typical": ["three_quarter", "front", "side"] },
  "measures": {
    "walls.width": { "default": 5, "min": 4, "max": 5.2, "step": 0.3, "means": "wall width across the gable (x)" },
    "walls.length": { "default": 5.9, "min": 4.5, "max": 6, "step": 0.3, "means": "wall length along the ridge (z)" },
    "walls.height": { "default": 3, "min": 2.5, "max": 3.5, "step": 0.25, "means": "wall height to the eaves" },
    "walls.lean": { "default": 0, "min": 0, "max": 0.4, "step": 0.2, "fit": false, "means": "how far each side wall leans in at the top" },
    "walls.bevel": { "default": 0.08, "min": 0.03, "max": 0.2, "step": 0.05, "fit": false, "means": "rounding of the wall edges" },
    "roof.pitch": { "default": 38, "min": 25, "max": 50, "step": 7, "fit": false, "means": "roof pitch in degrees" },
    "roof.overhang": { "default": 0.3, "min": 0.05, "max": 0.5, "step": 0.1, "means": "how far the roof reaches past the walls" },
    "chimney.size": { "default": 0.6, "min": 0.45, "max": 0.8, "step": 0.1, "means": "chimney width and depth" },
    "chimney.height": { "default": 1.8, "min": 1.2, "max": 1.9, "step": 0.15, "means": "chimney height from its foot 0.3 m inside the roof" },
    "chimney.crook": { "default": 0, "min": 0, "max": 13, "step": 0, "fit": false, "means": "how far the chimney leans, degrees" },
    "door.width": { "default": 1, "min": 0.8, "max": 1.2, "step": 0.1, "means": "door width" },
    "door.height": { "default": 1.7, "min": 1.5, "max": 1.9, "step": 0.1, "means": "door height to the spring of the arch" },
    "door.arch": { "default": 1, "min": 0, "max": 1, "step": 0, "count": true, "means": "1 for an arched door top, 0 for square" },
    "windows.count": { "default": 2, "min": 0, "max": 4, "step": 1, "count": true, "means": "windows along the +x wall" },
    "windows.size": { "default": 1, "min": 0.8, "max": 1.3, "step": 0.15, "means": "window scale" },
    "windows.arch": { "default": 1, "min": 0, "max": 1, "step": 0, "count": true, "means": "1 for round-topped windows, 0 for square" }
  },
  "parts": [
    { "name": "walls", "role": "body", "solid": "body", "gen": "loft", "params": { "size0": ["walls.width", "walls.length"], "size1": ["walls.width - 2 * walls.lean", "walls.length"], "height": "walls.height", "bevel": "walls.bevel" }, "at": ["0", "walls.height / 2", "0"] },
    { "name": "gable", "role": "body", "solid": "body", "gen": "loft", "group": "roof", "params": { "size0": ["walls.width - 2 * walls.lean", "walls.length"], "size1": ["0.1", "walls.length"], "height": "(walls.width / 2 - walls.lean) * sin(roof.pitch) / cos(roof.pitch)", "bevel": "0" }, "at": ["0", "walls.height + (walls.width / 2 - walls.lean) * sin(roof.pitch) / cos(roof.pitch) / 2", "0"] },
    { "name": "roof", "role": "body", "solid": "body", "gen": "rounded_box", "mirror": "x", "params": { "size": ["(walls.width / 2 - walls.lean) / cos(roof.pitch) + roof.overhang", "0.2", "walls.length + 2 * roof.overhang"], "bevel": "0.05" }, "rot": ["0", "0", "-roof.pitch"], "at": ["((walls.width / 2 - walls.lean) / cos(roof.pitch) + roof.overhang) / 2 * cos(roof.pitch) + 0.08 * sin(roof.pitch)", "walls.height + (walls.width / 2 - walls.lean) * sin(roof.pitch) / cos(roof.pitch) - ((walls.width / 2 - walls.lean) / cos(roof.pitch) + roof.overhang) / 2 * sin(roof.pitch) + 0.08 * cos(roof.pitch)", "0"] },
    { "name": "ridge", "role": "trim", "solid": "body", "gen": "cylinder", "group": "roof", "params": { "radius": "0.14", "length": "walls.length + 2 * roof.overhang", "axis": "z", "bevel": "0.05" }, "at": ["0", "walls.height + (walls.width / 2 - walls.lean) * sin(roof.pitch) / cos(roof.pitch) + 0.18 / cos(roof.pitch) - 0.04", "0"] },
    { "name": "chimney", "role": "body", "solid": "body", "gen": "rounded_box", "params": { "size": ["chimney.size", "chimney.height", "chimney.size"], "bevel": "0.06" }, "rot": ["0", "0", "chimney.crook"], "at": ["-0.24 * walls.width", "walls.height + (walls.width / 2 - walls.lean - 0.24 * walls.width) * sin(roof.pitch) / cos(roof.pitch) - 0.3 + chimney.height / 2", "-0.25 * walls.length"] },
    { "name": "chimney_cap", "role": "trim", "solid": "body", "gen": "rounded_box", "group": "chimney", "params": { "size": ["chimney.size + 0.12", "0.14", "chimney.size + 0.12"], "bevel": "0.04" }, "rot": ["0", "0", "chimney.crook"], "at": ["-0.24 * walls.width - (chimney.height / 2 - 0.07) * sin(chimney.crook)", "walls.height + (walls.width / 2 - walls.lean - 0.24 * walls.width) * sin(roof.pitch) / cos(roof.pitch) - 0.3 + chimney.height / 2 + (chimney.height / 2 - 0.07) * cos(chimney.crook)", "-0.25 * walls.length"] },
    { "name": "door", "role": "detail", "solid": "body", "gen": "rounded_box", "op": "cut", "params": { "size": ["door.width", "door.height - 0.06", "0.5"], "bevel": "0.03" }, "at": ["0", "(door.height + 0.06) / 2", "walls.length / 2"] },
    { "name": "door_arch", "role": "detail", "solid": "body", "gen": "cylinder", "op": "cut", "group": "door", "count": "door.arch", "params": { "radius": "door.width / 2 + 0.01", "length": "0.5", "axis": "z", "bevel": "0.03" }, "at": ["0", "door.height", "walls.length / 2"] },
    { "name": "windows", "role": "detail", "solid": "body", "gen": "rounded_box", "op": "cut", "count": "windows.count", "spread": "min(1.6, (walls.length - 1.4) / max(1, windows.count))", "spread_axis": "z", "params": { "size": ["0.5", "0.8 * windows.size", "0.7 * windows.size"], "bevel": "0.03" }, "at": ["walls.width / 2 - walls.lean * 1.5 / walls.height", "1.5", "0"] },
    { "name": "window_arches", "role": "detail", "solid": "body", "gen": "cylinder", "op": "cut", "group": "windows", "count": "windows.count * windows.arch", "spread": "min(1.6, (walls.length - 1.4) / max(1, windows.count))", "spread_axis": "z", "params": { "radius": "0.35 * windows.size + 0.01", "length": "0.5", "axis": "x", "bevel": "0.03" }, "at": ["walls.width / 2 - walls.lean * (1.5 + 0.4 * windows.size) / walls.height", "1.5 + 0.4 * windows.size", "0"] }
  ],
  "groups": {},
  "variants": {
    "roof.shape": { "gable": {} },
    "door.shape": { "arched": {}, "square": { "set": { "door.arch": 0 } } },
    "windows.shape": { "round_top": {}, "square": { "set": { "windows.arch": 0 } } }
  },
  "counts": { "windows.count": "windows.count" },
  "anchors": [
    { "name": "door", "at": "door.front" },
    { "name": "chimney_top", "at": "chimney_cap.top" },
    { "name": "ridge", "at": "ridge.centre" }
  ],
  "musts": { "connected": true, "stands": "ground" },
  "collision": { "footprint": "box" }
}
