{
  "class": "kart",
  "version": 1,
  "family": "vehicles",
  "means": "a go-kart at the kart racer's game scale (about 3.1 m long): chassis tub, nose, side pods, bumper, engine cover with exhausts, rear wing on struts, seat, steering and four wheels",
  "source": "proportions measured from our own kart racer kit (kits/evani-kit-kart-racer draw_kart, our code); front track widened and tub shortened so the front wheels clear the body when steered",
  "default_style": "toon_chunky",
  "view": { "distance_m": 6.0, "typical": ["chase", "side", "top", "front"] },
  "measures": {
    "chassis.length": { "default": 1.7, "min": 1.3, "max": 2.1, "step": 0.15, "means": "tub length" },
    "chassis.width": { "default": 1.12, "min": 0.9, "max": 1.2, "step": 0.08, "means": "tub width" },
    "chassis.height": { "default": 0.3, "min": 0.22, "max": 0.45, "step": 0.05, "means": "tub height" },
    "chassis.ride_height": { "default": 0.21, "min": 0.1, "max": 0.32, "step": 0.03, "means": "ground to tub bottom" },
    "chassis.roundness": { "default": 1.0, "min": 0.4, "max": 2.0, "step": 0.4, "means": "edge rounding of the tub" },
    "nose.length": { "default": 0.85, "min": 0.6, "max": 1.0, "step": 0.08, "means": "nose length" },
    "nose.width": { "default": 1.05, "min": 0.8, "max": 1.1, "step": 0.06, "means": "nose width" },
    "nose.height": { "default": 0.34, "min": 0.25, "max": 0.45, "step": 0.05, "means": "nose height" },
    "nose.rake": { "default": 8.0, "min": 0.0, "max": 25.0, "step": 4.6, "means": "nose pitch in degrees" },
    "nose.taper": { "default": 0.0, "min": 0.0, "max": 0.7, "step": 0.15, "means": "narrowing towards the front" },
    "nose.roundness": { "default": 1.0, "min": 0.4, "max": 2.0, "step": 0.4, "means": "edge rounding of the nose" },
    "side_pods.scale": { "default": 1.0, "min": 0.7, "max": 1.3, "step": 0.12, "means": "side pod size" },
    "side_pods.roundness": { "default": 1.0, "min": 0.4, "max": 2.0, "step": 0.4, "means": "edge rounding of the side pods" },
    "side_pods.yaw": { "default": 0.0, "min": 0.0, "max": 15.0, "step": 6.0, "means": "side pod toe angle in degrees" },
    "bumper.width": { "default": 1.4, "min": 1.0, "max": 1.44, "step": 0.08, "means": "bumper width" },
    "bumper.height": { "default": 0.22, "min": 0.14, "max": 0.3, "step": 0.04, "means": "bumper height" },
    "bumper.depth": { "default": 0.28, "min": 0.18, "max": 0.34, "step": 0.04, "means": "bumper depth" },
    "engine_cover.scale": { "default": 1.0, "min": 0.8, "max": 1.3, "step": 0.12, "means": "engine cover size" },
    "engine_cover.exhausts": { "default": 2, "min": 0, "max": 4, "step": 1, "count": true, "means": "number of exhausts" },
    "exhaust.length": { "default": 0.42, "min": 0.3, "max": 0.62, "step": 0.08, "means": "exhaust length" },
    "exhaust.radius": { "default": 0.1, "min": 0.06, "max": 0.13, "step": 0.015, "means": "exhaust radius" },
    "wing.span": { "default": 1.6, "min": 1.1, "max": 1.7, "step": 0.15, "means": "wing span" },
    "wing.chord": { "default": 0.42, "min": 0.3, "max": 0.5, "step": 0.06, "means": "wing chord" },
    "wing.y": { "default": 1.14, "min": 1.0, "max": 1.2, "step": 0.05, "means": "wing height" },
    "wing.thick": { "default": 0.09, "min": 0.07, "max": 0.12, "step": 0.015, "means": "wing thickness" },
    "wing.struts": { "default": 2, "min": 2, "max": 2, "step": 0, "count": true, "means": "wing struts (a mirrored pair)" },
    "wing_struts.drop": { "default": 0.0, "min": 0.0, "max": 0.4, "step": 0.05, "means": "how far the struts reach down into the engine cover" },
    "seat.width": { "default": 0.72, "min": 0.6, "max": 0.9, "step": 0.04, "means": "seat width" },
    "seat.rake": { "default": -16.0, "min": -30.0, "max": -4.0, "step": 4.0, "means": "seat back pitch in degrees" },
    "seat.bolsters": { "default": 0, "min": 0, "max": 1, "step": 1, "count": true, "means": "bucket side bolsters (0 or 1 pair)" },
    "front_tyres.radius": { "default": 0.33, "min": 0.28, "max": 0.38, "step": 0.02, "means": "front tyre radius" },
    "front_tyres.width": { "default": 0.32, "min": 0.24, "max": 0.36, "step": 0.03, "means": "front tyre width" },
    "rear_tyres.radius": { "default": 0.42, "min": 0.32, "max": 0.52, "step": 0.03, "means": "rear tyre radius" },
    "rear_tyres.width": { "default": 0.44, "min": 0.32, "max": 0.46, "step": 0.03, "means": "rear tyre width" },
    "front.track": { "default": 1.8, "min": 1.7, "max": 1.84, "step": 0.04, "means": "front track (hub to hub)" },
    "front.z": { "default": 0.95, "min": 0.85, "max": 1.05, "step": 0.04, "means": "front axle position at the base tub and nose length (the axle moves with them)" },
    "rear.track": { "default": 1.68, "min": 1.6, "max": 1.72, "step": 0.04, "means": "rear track (hub to hub)" },
    "rear.z": { "default": -0.86, "min": -0.95, "max": -0.8, "step": 0.03, "means": "rear axle position" }
  },
  "parts": [
    { "name": "chassis", "role": "body", "solid": "body", "gen": "rounded_box",
      "params": { "size": ["chassis.width", "chassis.height", "chassis.length"], "bevel": "style.bevel * chassis.roundness * min(chassis.width, chassis.height)" },
      "at": ["0", "chassis.ride_height + chassis.height / 2", "-1.15 + chassis.length / 2"] },
    { "name": "nose", "role": "body", "solid": "body", "gen": "rounded_box",
      "params": { "size": ["nose.width", "nose.height", "nose.length + 0.1 * max(0, nose.roundness - 1) + 0.1 * max(0, chassis.roundness - 1)"], "taper": "nose.taper", "bevel": "style.bevel * nose.roundness * nose.height" },
      "rot": ["0", "nose.rake", "0"],
      "relations": [{ "kind": "attached_at", "self": "back", "to": "chassis.front", "offset": ["0", "0.25", "-0.045 - 0.1 * max(0, nose.roundness - 1) - 0.1 * max(0, chassis.roundness - 1)"] }] },
    { "name": "side_pods", "role": "body", "solid": "body", "gen": "rounded_box", "mirror": "x",
      "params": { "size": ["0.34 * side_pods.scale", "0.38 * side_pods.scale", "0.76 * side_pods.scale"], "bevel": "style.bevel * side_pods.roundness * 0.34 * side_pods.scale" },
      "rot": ["side_pods.yaw", "0", "0"],
      "relations": [{ "kind": "attached_at", "self": "right", "to": "chassis.left", "offset": ["-0.07", "0.1", "0.28"] }] },
    { "name": "bumper", "role": "body", "solid": "body", "gen": "rounded_box",
      "params": { "size": ["bumper.width", "bumper.height", "bumper.depth"], "bevel": "style.bevel * min(bumper.height, bumper.depth)" },
      "at": ["0", "0.19 + bumper.height / 2 + 0.7 * style.bevel * nose.height * max(0, nose.roundness - 1)", "chassis.length + nose.length - 0.995 - bumper.depth / 2 - 0.7 * style.bevel * nose.height * max(0, nose.roundness - 1)"] },
    { "name": "engine_cover", "role": "body", "solid": "body", "gen": "rounded_box",
      "params": { "size": ["0.95 * engine_cover.scale", "0.44 * engine_cover.scale", "0.5 * engine_cover.scale"], "bevel": "style.bevel * 0.44 * engine_cover.scale" },
      "relations": [{ "kind": "attached_at", "self": "bottom", "to": "chassis.top", "offset": ["0", "-0.13", "-0.98 - (-1.15 + chassis.length / 2)"] }] },
    { "name": "exhausts", "role": "trim", "solid": "body", "gen": "cylinder", "group": "engine_cover",
      "count": "engine_cover.exhausts", "spread": "min(0.52, 1.04 / max(1, engine_cover.exhausts))",
      "params": { "radius": "exhaust.radius", "length": "exhaust.length", "axis": "y", "bevel": "0.3 * exhaust.radius" },
      "rot": ["0", "78.5", "0"],
      "at": ["0", "0.78 + (exhaust.length - 0.42) * 0.1", "-1.31 + (exhaust.length - 0.42) * 0.49"] },
    { "name": "wing_struts", "role": "trim", "solid": "body", "gen": "rounded_box", "mirror": "x", "group": "wing",
      "params": { "size": ["0.08", "wing.y - (0.33 + 0.44 * engine_cover.scale - wing_struts.drop)", "0.1"], "bevel": "0.02" },
      "at": ["0.39 * wing.span / 1.6", "(wing.y + 0.33 + 0.44 * engine_cover.scale - wing_struts.drop) / 2", "-1.12"] },
    { "name": "wing", "role": "body", "solid": "body", "gen": "rounded_box", "group": "wing",
      "params": { "size": ["wing.span", "wing.thick", "wing.chord"], "bevel": "style.bevel * 0.5 * wing.thick" },
      "rot": ["0", "-6.9", "0"],
      "at": ["0", "wing.y", "-1.18"] },
    { "name": "seat_base", "role": "body", "solid": "body", "gen": "rounded_box", "group": "seat",
      "params": { "size": ["seat.width", "0.16", "0.62"], "bevel": "style.bevel * 0.16" },
      "at": ["0", "0.6", "-0.3"],
      "relations": [{ "kind": "rests_on", "to": "chassis", "embed": "0.01" }] },
    { "name": "seat_back", "role": "body", "solid": "body", "gen": "rounded_box", "group": "seat",
      "params": { "size": ["seat.width + 0.02", "0.7", "0.16"], "bevel": "style.bevel * 0.16" },
      "rot": ["0", "seat.rake", "0"],
      "relations": [{ "kind": "attached_at", "self": "bottom", "to": "seat_base.back", "offset": ["0", "-0.036", "0.055"] }] },
    { "name": "seat_sides", "role": "trim", "solid": "body", "gen": "rounded_box", "group": "seat", "mirror": "x",
      "count": "seat.bolsters", "spread": "0",
      "params": { "size": ["0.1", "0.3", "0.55"], "bevel": "0.03" },
      "at": ["seat.width / 2", "1.0", "-0.3"],
      "relations": [{ "kind": "rests_on", "to": "seat_base", "embed": "0.02" }] },
    { "name": "steering_column", "role": "detail", "solid": "body", "gen": "rounded_box", "group": "steering",
      "params": { "size": ["0.08", "0.08", "0.5"], "bevel": "0.02" },
      "rot": ["0", "51.6", "0"],
      "at": ["0", "0.78", "0.5"] },
    { "name": "steering_wheel", "role": "detail", "solid": "body", "gen": "cylinder", "group": "steering",
      "params": { "radius": "0.23", "length": "0.06", "axis": "y", "bevel": "0.02" },
      "rot": ["0", "-57.3", "0"],
      "relations": [{ "kind": "attached_at", "self": "centre", "to": "steering_column.back", "offset": ["0", "0", "0"] }] },
    { "name": "front_tyres", "role": "wheel", "solid": "wheel_f{side}", "gen": "wheel", "split": "x", "group": "tyres",
      "params": { "radius": "front_tyres.radius", "width": "front_tyres.width", "bevel": "0.3 * min(front_tyres.width, front_tyres.radius)" },
      "at": ["front.track / 2", "front_tyres.radius", "front.z + (chassis.length - 1.7) + (nose.length - 0.85) - 0.7 * style.bevel * nose.height * max(0, nose.roundness - 1)"] },
    { "name": "rear_tyres", "role": "wheel", "solid": "wheel_r{side}", "gen": "wheel", "split": "x", "group": "tyres",
      "params": { "radius": "rear_tyres.radius", "width": "rear_tyres.width", "bevel": "0.3 * min(rear_tyres.width, rear_tyres.radius)" },
      "at": ["rear.track / 2", "rear_tyres.radius", "rear.z"] }
  ],
  "groups": {
    "tyres": ["front_tyres", "rear_tyres"],
    "wheels": ["front_tyres", "rear_tyres"],
    "wing": ["wing", "wing_struts"],
    "seat": ["seat_base", "seat_back", "seat_sides"],
    "steering": ["steering_column", "steering_wheel"]
  },
  "variants": {
    "nose.shape": {
      "wedge": { "set": { "nose.taper": 0.25 } },
      "blunt": { "set": { "nose.taper": 0.0, "nose.roundness": 1.6, "nose.length": 0.75 } },
      "pointed": { "set": { "nose.taper": 0.6, "nose.length": 0.95 } },
      "round": { "gen": "ellipsoid", "params": { "size": ["nose.width", "nose.height * 1.2", "nose.length"] } }
    },
    "engine_cover.shape": {
      "block": {},
      "bubble": { "gen": "ellipsoid", "params": { "size": ["1.0 * engine_cover.scale", "0.66 * engine_cover.scale", "0.64 * engine_cover.scale"] }, "set": { "wing_struts.drop": 0.2 } }
    },
    "side_pods.shape": {
      "box": {},
      "round": { "gen": "ellipsoid", "params": { "size": ["0.36 * side_pods.scale", "0.38 * side_pods.scale", "0.8 * side_pods.scale"] } }
    },
    "bumper.type": { "bar": {} },
    "wing.type": { "flat": {} },
    "seat.type": {
      "raked": { "set": { "seat.bolsters": 0 } },
      "bucket": { "set": { "seat.bolsters": 1, "seat.width": 0.84 } }
    },
    "steering.type": { "column": {} }
  },
  "counts": { "engine_cover.exhausts": "engine_cover.exhausts", "wing.struts": "wing.struts" },
  "anchors": [
    { "name": "driver_seat", "at": "seat_base.top" },
    { "name": "wheel_hub.fl", "at": "front_tyres.l.hub" },
    { "name": "wheel_hub.fr", "at": "front_tyres.r.hub" },
    { "name": "wheel_hub.rl", "at": "rear_tyres.l.hub" },
    { "name": "wheel_hub.rr", "at": "rear_tyres.r.hub" },
    { "name": "exhaust.l", "at": "exhausts.last.bottom" },
    { "name": "exhaust.r", "at": "exhausts.first.bottom" },
    { "name": "steer_pivot", "at": "steering_wheel.centre" },
    { "name": "item_slot", "at": "wing.top" }
  ],
  "musts": { "connected": true, "stands": "ground", "symmetric": "x" },
  "steer": { "parts": ["front_tyres"], "axis": [0.0, 1.0, 0.0], "against": "body" },
  "seat": { "anchor": "driver_seat", "seat_parts": ["seat_base", "seat_back", "seat_sides"], "contact_parts": ["steering_wheel", "steering_column"] },
  "collision": { "footprint": "capsule" }
}
