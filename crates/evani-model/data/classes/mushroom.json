{
  "class": "mushroom",
  "version": 1,
  "family": "organic",
  "means": "a toadstool: a bulging, slightly leaning stem under a domed cap with a flat underside, a rolled rim, gills underneath and raised spots on top",
  "source": "our own proportions for a chunky toon toadstool (about 1.1 m across, 1.27 m tall); the cap is a quarter ellipse over a flat underside",
  "default_style": "toon_chunky",
  "view": { "distance_m": 5.0, "typical": ["three_quarter", "front", "top"] },
  "clip_floor": true,
  "measures": {
    "stem.radius": { "default": 0.16, "min": 0.1, "max": 0.2, "step": 0.015, "means": "stem radius" },
    "stem.bulge": { "default": 0.0, "min": 0.0, "max": 0.07, "step": 0, "fit": false, "means": "extra radius low on the stem" },
    "stem.curve": { "default": 0.0, "min": 0.0, "max": 14.0, "step": 0, "fit": false, "means": "how far the stem leans, degrees" },
    "stem.height": { "default": 0.75, "min": 0.5, "max": 0.8, "step": 0.05, "means": "height of the cap underside" },
    "cap.radius": { "default": 0.53, "min": 0.35, "max": 0.57, "step": 0.03, "means": "cap radius" },
    "cap.height": { "default": 0.5, "min": 0.3, "max": 0.55, "step": 0.05, "means": "cap height above its underside" },
    "cap.rim": { "default": 0.0, "min": 0.0, "max": 0.06, "step": 0, "fit": false, "means": "radius of the rolled rim (0 for none)" },
    "gills.count": { "default": 24, "min": 8, "max": 36, "step": 1, "count": true, "means": "gills under the cap" },
    "gills.depth": { "default": 0.05, "min": 0.02, "max": 0.08, "step": 0.015, "means": "how far the gills hang below the cap" },
    "spots.count": { "default": 7, "min": 1, "max": 12, "step": 1, "count": true, "means": "spots: one on top and the rest in a ring" },
    "spots.raise": { "default": 0.01, "min": 0.0, "max": 0.03, "step": 0.01, "fit": false, "means": "how far the spots stand out" }
  },
  "parts": [
    { "name": "stem", "role": "body", "solid": "body", "gen": "lathe",
      "params": { "profile": [
        "stem.radius + 0.01", "-0.05",
        "stem.radius + 0.6 * stem.bulge", "0.15",
        "stem.radius + stem.bulge", "0.3",
        "stem.radius + 0.4 * stem.bulge - 0.01", "0.5",
        "stem.radius - 0.03", "stem.height + 0.08"
      ] },
      "rot": ["0", "0", "-stem.curve"],
      "at": ["-(stem.height + 0.08) * sin(stem.curve)", "0", "0"] },
    { "name": "cap", "role": "body", "solid": "body", "gen": "lathe",
      "params": { "profile": [
        "cap.radius - 0.06", "0",
        "cap.radius - 0.015", "0.02",
        "cap.radius", "0.08",
        "cap.radius * 0.92388", "0.08 + (cap.height - 0.08) * 0.38268",
        "cap.radius * 0.70711", "0.08 + (cap.height - 0.08) * 0.70711",
        "cap.radius * 0.38268", "0.08 + (cap.height - 0.08) * 0.92388",
        "0", "cap.height"
      ] },
      "at": ["0", "stem.height", "0"] },
    { "name": "rim", "role": "trim", "solid": "body", "gen": "tube", "group": "cap_rim",
      "count": "min(1, cap.rim * 100)",
      "params": { "radius": "cap.rim", "points": [
        "0", "0", "(cap.radius - 0.03) * 1.00000",
        "(cap.radius - 0.03) * 0.38268", "0", "(cap.radius - 0.03) * 0.92388",
        "(cap.radius - 0.03) * 0.70711", "0", "(cap.radius - 0.03) * 0.70711",
        "(cap.radius - 0.03) * 0.92388", "0", "(cap.radius - 0.03) * 0.38268",
        "(cap.radius - 0.03) * 1.00000", "0", "0",
        "(cap.radius - 0.03) * 0.92388", "0", "(cap.radius - 0.03) * -0.38268",
        "(cap.radius - 0.03) * 0.70711", "0", "(cap.radius - 0.03) * -0.70711",
        "(cap.radius - 0.03) * 0.38268", "0", "(cap.radius - 0.03) * -0.92388",
        "0", "0", "(cap.radius - 0.03) * -1.00000",
        "(cap.radius - 0.03) * -0.38268", "0", "(cap.radius - 0.03) * -0.92388",
        "(cap.radius - 0.03) * -0.70711", "0", "(cap.radius - 0.03) * -0.70711",
        "(cap.radius - 0.03) * -0.92388", "0", "(cap.radius - 0.03) * -0.38268",
        "(cap.radius - 0.03) * -1.00000", "0", "0",
        "(cap.radius - 0.03) * -0.92388", "0", "(cap.radius - 0.03) * 0.38268",
        "(cap.radius - 0.03) * -0.70711", "0", "(cap.radius - 0.03) * 0.70711",
        "(cap.radius - 0.03) * -0.38268", "0", "(cap.radius - 0.03) * 0.92388",
        "0", "0", "(cap.radius - 0.03) * 1.00000"
      ] },
      "at": ["0", "stem.height + 0.05", "0"] },
    { "name": "gills", "role": "detail", "solid": "body", "gen": "rounded_box",
      "count": "gills.count", "layout": "ring", "radius": "(stem.radius + cap.radius - 0.06) / 2",
      "params": { "size": ["0.02", "gills.depth + 0.02", "cap.radius - stem.radius - 0.1"], "bevel": "0.008" },
      "at": ["0", "stem.height - gills.depth / 2 + 0.01", "0"] },
    { "name": "spots", "role": "trim", "solid": "body", "gen": "ellipsoid",
      "count": "spots.count - 1", "layout": "ring", "start": "20",
      "radius": "0.6 * cap.radius + 0.559 * (spots.raise - 0.025)",
      "params": { "size": ["0.15", "0.05", "0.15"] },
      "rot": ["0", "34", "0"],
      "at": ["0", "stem.height + 0.08 + 0.8 * (cap.height - 0.08) + 0.829 * (spots.raise - 0.025)", "0"] },
    { "name": "top_spot", "role": "trim", "solid": "body", "gen": "ellipsoid", "group": "spots_top",
      "params": { "size": ["0.17", "0.05", "0.17"] },
      "at": ["0", "stem.height + cap.height + spots.raise - 0.025", "0"] }
  ],
  "groups": {},
  "variants": { "cap.shape": { "dome": {} } },
  "counts": { "gills.count": "gills.count", "spots.count": "spots.count" },
  "anchors": [ { "name": "top", "at": "cap.top" } ],
  "musts": { "connected": true, "stands": "ground" },
  "collision": { "footprint": "cylinder" }
}
