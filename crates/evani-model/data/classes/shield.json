{
  "class": "shield",
  "version": 1,
  "family": "props",
  "means": "a round shield: a plano-convex face (flat back, domed front), a rim tube round its edge, a boss in the middle, straps across the back and a grip held off the back by two blocks",
  "source": "our own proportions for a chunky toon round shield (about 0.78 m across); the grip is about 3 cm across",
  "default_style": "toon_chunky",
  "view": {
    "distance_m": 3,
    "typical": [
      "front",
      "three_quarter",
      "back"
    ]
  },
  "measures": {
    "face.radius": { "default": 0.37, "min": 0.25, "max": 0.38, "step": 0.03, "means": "face radius" },
    "face.thick": { "default": 0.03, "min": 0.02, "max": 0.04, "step": 0.005, "means": "face thickness at the edge" },
    "face.dome": { "default": 0.03, "min": 0.0, "max": 0.08, "step": 0.015, "fit": false, "means": "how far the middle of the face bulges forward" },
    "rim.thick": { "default": 0.022, "min": 0.015, "max": 0.03, "step": 0.004, "means": "rim tube radius" },
    "boss.scale": { "default": 1.0, "min": 0.7, "max": 1.4, "step": 0.15, "means": "boss size" },
    "straps.count": { "default": 2, "min": 1, "max": 3, "step": 1, "count": true, "means": "straps across the back" },
    "grip.radius": { "default": 0.015, "min": 0.012, "max": 0.02, "step": 0.002, "means": "grip radius" }
  },
  "parts": [
    { "name": "face", "role": "body", "solid": "body", "gen": "lathe",
      "params": { "profile": [
        "0", "face.thick + face.dome",
        "0.5 * face.radius", "face.thick + 0.75 * face.dome",
        "0.75 * face.radius", "face.thick + 0.4375 * face.dome",
        "face.radius", "face.thick",
        "face.radius", "0"
      ] },
      "rot": ["0", "90", "0"],
      "at": ["0", "face.radius + 0.03", "0"] },
    { "name": "rim", "role": "trim", "solid": "body", "gen": "tube",
      "params": { "radius": "rim.thick", "points": [
        "0", "(face.radius - 0.004) * 1.00000", "face.thick / 2",
        "(face.radius - 0.004) * 0.38268", "(face.radius - 0.004) * 0.92388", "face.thick / 2",
        "(face.radius - 0.004) * 0.70711", "(face.radius - 0.004) * 0.70711", "face.thick / 2",
        "(face.radius - 0.004) * 0.92388", "(face.radius - 0.004) * 0.38268", "face.thick / 2",
        "(face.radius - 0.004) * 1.00000", "0", "face.thick / 2",
        "(face.radius - 0.004) * 0.92388", "(face.radius - 0.004) * -0.38268", "face.thick / 2",
        "(face.radius - 0.004) * 0.70711", "(face.radius - 0.004) * -0.70711", "face.thick / 2",
        "(face.radius - 0.004) * 0.38268", "(face.radius - 0.004) * -0.92388", "face.thick / 2",
        "0", "(face.radius - 0.004) * -1.00000", "face.thick / 2",
        "(face.radius - 0.004) * -0.38268", "(face.radius - 0.004) * -0.92388", "face.thick / 2",
        "(face.radius - 0.004) * -0.70711", "(face.radius - 0.004) * -0.70711", "face.thick / 2",
        "(face.radius - 0.004) * -0.92388", "(face.radius - 0.004) * -0.38268", "face.thick / 2",
        "(face.radius - 0.004) * -1.00000", "0", "face.thick / 2",
        "(face.radius - 0.004) * -0.92388", "(face.radius - 0.004) * 0.38268", "face.thick / 2",
        "(face.radius - 0.004) * -0.70711", "(face.radius - 0.004) * 0.70711", "face.thick / 2",
        "(face.radius - 0.004) * -0.38268", "(face.radius - 0.004) * 0.92388", "face.thick / 2",
        "0", "(face.radius - 0.004) * 1.00000", "face.thick / 2"
      ] },
      "at": ["0", "face.radius + 0.03", "0"] },
    { "name": "boss", "role": "trim", "solid": "body", "gen": "ellipsoid",
      "params": { "size": ["0.16 * boss.scale", "0.16 * boss.scale", "0.08 * boss.scale"] },
      "at": ["0", "face.radius + 0.03", "face.thick + face.dome - 0.012"] },
    { "name": "straps", "role": "trim", "solid": "body", "gen": "rounded_box",
      "count": "straps.count", "spread": "0.28", "spread_axis": "y",
      "params": { "size": ["1.3 * face.radius", "0.05", "0.016"], "bevel": "0.005" },
      "at": ["0", "face.radius + 0.03", "0"] },
    { "name": "grip_mounts", "role": "body", "solid": "body", "gen": "rounded_box", "mirror": "x",
      "params": { "size": ["0.03", "0.045", "0.055"], "bevel": "0.008" },
      "at": ["0.07", "face.radius + 0.03", "-0.0225"] },
    { "name": "grip", "role": "body", "solid": "body", "gen": "cylinder",
      "params": { "radius": "grip.radius", "length": "0.17", "axis": "x", "bevel": "0.005" },
      "at": ["0", "face.radius + 0.03", "-0.03 - grip.radius"] }
  ],
  "groups": {},
  "variants": {
    "face.shape": { "round": {} },
    "boss.shape": { "dome": {} }
  },
  "counts": { "straps.count": "straps.count" },
  "anchors": [ { "name": "grip", "at": "grip.centre" }, { "name": "face", "at": "boss.front" } ],
  "musts": { "connected": true },
  "collision": { "footprint": "cylinder" }
}
