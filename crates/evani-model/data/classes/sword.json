{
  "class": "sword",
  "version": 1,
  "family": "props",
  "means": "a one-handed sword standing on its tip: a bevelled blade with a tapered tip and an optional fuller, a bar guard with optional curled ends, a grip and a ball pommel",
  "source": "our own proportions for a chunky toon sword (about 1.1 m); the tip keeps at least 9 mm of thickness",
  "default_style": "toon_chunky",
  "view": { "distance_m": 2.5, "typical": ["front", "three_quarter", "side"] },
  "measures": {
    "blade.length": { "default": 0.68, "min": 0.5, "max": 0.78, "step": 0.05, "means": "blade length above the tip" },
    "blade.width": { "default": 0.07, "min": 0.05, "max": 0.1, "step": 0.012, "means": "blade width" },
    "blade.thick": { "default": 0.022, "min": 0.018, "max": 0.03, "step": 0.003, "means": "blade thickness" },
    "blade.tip": { "default": 0.5, "min": 0.15, "max": 0.58, "step": 0.08, "fit": false, "means": "how much the tip narrows (0 blunt, 0.58 sharpest)" },
    "blade.tip_length": { "default": 0.13, "min": 0.08, "max": 0.18, "step": 0.02, "means": "tip length" },
    "blade.fuller": { "default": 0.0, "min": 0.0, "max": 0.005, "step": 0, "fit": false, "means": "depth of the groove down each face" },
    "guard.width": { "default": 0.28, "min": 0.2, "max": 0.3, "step": 0.02, "means": "guard width" },
    "guard.curls": { "default": 0, "min": 0, "max": 1, "step": 1, "count": true, "means": "1 for curled guard ends" },
    "grip.length": { "default": 0.19, "min": 0.14, "max": 0.24, "step": 0.02, "means": "grip length" },
    "grip.radius": { "default": 0.0175, "min": 0.014, "max": 0.022, "step": 0.002, "means": "grip radius" },
    "grip.wraps": { "default": 0, "min": 0, "max": 6, "step": 4, "count": true, "means": "wrap rings round the grip" },
    "pommel.size": { "default": 0.06, "min": 0.045, "max": 0.08, "step": 0.01, "means": "pommel diameter" }
  },
  "parts": [
    { "name": "blade", "role": "body", "solid": "body", "gen": "rounded_box",
      "params": { "size": ["blade.width", "blade.length", "blade.thick"], "bevel": "0.45 * blade.thick" },
      "at": ["0", "blade.tip_length + blade.length / 2 - 0.004", "0"] },
    { "name": "tip", "role": "body", "solid": "body", "gen": "rounded_box", "group": "blade_tip",
      "params": { "size": ["blade.width", "blade.thick", "blade.tip_length"], "bevel": "0.45 * blade.thick", "taper": "blade.tip" },
      "rot": ["0", "90", "0"],
      "at": ["0", "blade.tip_length / 2", "0"] },
    { "name": "fuller_front", "role": "detail", "solid": "body", "gen": "rounded_box", "op": "cut", "group": "fuller",
      "count": "min(1, blade.fuller * 1000)",
      "params": { "size": ["0.3 * blade.width", "0.7 * blade.length", "2 * blade.fuller"], "bevel": "0.4 * blade.fuller" },
      "at": ["0", "blade.tip_length + blade.length * 0.45", "blade.thick / 2"] },
    { "name": "fuller_back", "role": "detail", "solid": "body", "gen": "rounded_box", "op": "cut", "group": "fuller",
      "count": "min(1, blade.fuller * 1000)",
      "params": { "size": ["0.3 * blade.width", "0.7 * blade.length", "2 * blade.fuller"], "bevel": "0.4 * blade.fuller" },
      "at": ["0", "blade.tip_length + blade.length * 0.45", "-blade.thick / 2"] },
    { "name": "guard", "role": "body", "solid": "body", "gen": "rounded_box",
      "params": { "size": ["guard.width", "0.035", "0.045"], "bevel": "0.014" },
      "at": ["0", "blade.tip_length + blade.length + 0.0095", "0"] },
    { "name": "guard_ends", "role": "trim", "solid": "body", "gen": "tube", "mirror": "x",
      "count": "guard.curls",
      "params": { "radius": "0.013", "points": [
        "guard.width / 2 - 0.02", "0", "0",
        "guard.width / 2 + 0.008", "-0.004", "0",
        "guard.width / 2 + 0.02", "-0.022", "0",
        "guard.width / 2 + 0.016", "-0.044", "0",
        "guard.width / 2 + 0.002", "-0.056", "0"
      ] },
      "at": ["0", "blade.tip_length + blade.length + 0.0095", "0"] },
    { "name": "grip", "role": "body", "solid": "body", "gen": "cylinder",
      "params": { "radius": "grip.radius", "length": "grip.length", "axis": "y", "bevel": "0.004" },
      "at": ["0", "blade.tip_length + blade.length + 0.027 - 0.008 + grip.length / 2", "0"] },
    { "name": "grip_wraps", "role": "detail", "solid": "body", "gen": "cylinder", "group": "grip_rings",
      "count": "grip.wraps", "spread": "grip.length / (grip.wraps + 1)", "spread_axis": "y",
      "params": { "radius": "grip.radius + 0.0025", "length": "0.012", "axis": "y", "bevel": "0.003" },
      "at": ["0", "blade.tip_length + blade.length + 0.019 + grip.length / 2", "0"] },
    { "name": "pommel", "role": "body", "solid": "body", "gen": "ellipsoid",
      "params": { "size": ["pommel.size", "pommel.size", "pommel.size"] },
      "at": ["0", "blade.tip_length + blade.length + 0.019 + grip.length + 0.35 * pommel.size", "0"] }
  ],
  "groups": {},
  "variants": {
    "guard.shape": { "bar": {} },
    "pommel.shape": { "ball": {} }
  },
  "counts": {},
  "anchors": [ { "name": "grip", "at": "grip.centre" } ],
  "musts": { "connected": true, "min_thickness": 0.006 },
  "collision": { "footprint": "box" }
}
