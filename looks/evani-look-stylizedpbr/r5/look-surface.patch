+
+// Lit model shading (feature `look-surface`, CORE_REQUESTS `smooth-lighting`).
+// Declared after everything else in this file: panic locations are in the
+// wasm, so other games' downloads stay byte-identical only if no line above
+// moves.
+
+#[cfg(not(feature = "look-surface"))]
+const MODEL_VS: &str = "model_vs";
+#[cfg(not(feature = "look-surface"))]
+const MODEL_FS: &str = "model_fs";
+#[cfg(feature = "look-surface")]
+const MODEL_VS: &str = "model_lit_vs";
+#[cfg(feature = "look-surface")]
+const MODEL_FS: &str = "model_lit_fs";
+
+/// The material group with the lit maps: 0-4 as without the feature, then
+/// metallic-roughness (5), occlusion (6), detail (7), the `ModelSurface`
+/// uniform (8) and the fur clump map (9).
+#[cfg(feature = "look-surface")]
+fn material_layout(dev: &wgpu::Device) -> wgpu::BindGroupLayout {
+    let tex = |binding| wgpu::BindGroupLayoutEntry {
+        binding,
+        visibility: wgpu::ShaderStages::FRAGMENT,
+        ty: wgpu::BindingType::Texture {
+            sample_type: wgpu::TextureSampleType::Float { filterable: true },
+            view_dimension: wgpu::TextureViewDimension::D2,
+            multisampled: false,
+        },
+        count: None,
+    };
+    let uniform = |binding| wgpu::BindGroupLayoutEntry {
+        binding,
+        visibility: wgpu::ShaderStages::FRAGMENT,
+        ty: wgpu::BindingType::Buffer {
+            ty: wgpu::BufferBindingType::Uniform,
+            has_dynamic_offset: false,
+            min_binding_size: None,
+        },
+        count: None,
+    };
+    dev.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+        label: Some("evani.layout.model_lit"),
+        entries: &[
+            uniform(0),
+            tex(1),
+            tex(2),
+            tex(3),
+            wgpu::BindGroupLayoutEntry {
+                binding: 4,
+                visibility: wgpu::ShaderStages::FRAGMENT,
+                ty: wgpu::BindingType::Sampler(wgpu::SamplerBindingType::Filtering),
+                count: None,
+            },
+            tex(5),
+            tex(6),
+            tex(7),
+            uniform(8),
+            tex(9),
+        ],
+    })
+}
+
+#[cfg(feature = "look-surface")]
+mod look {
+    use evani_core::ecs::World;
+    use evani_core::plugin::{GenRequest, GeneratedAsset, LookData};
+
+    use super::ModelGpu;
+    use crate::look_surface::{self, CLUMP_GENERATOR, DETAIL_GENERATOR, SURFACE_MAP_SIZE, SURFACE_WORDS};
+    use crate::model::ModelMaterial;
+
+    /// The look's tiling maps (detail, clump), made once per device.
+    #[derive(Default)]
+    pub struct LookMaps {
+        tried: bool,
+        detail: Option<(wgpu::Texture, wgpu::TextureView)>,
+        clump: Option<(wgpu::Texture, wgpu::TextureView)>,
+    }
+
+    /// A linear RGBA8 tiling map with its box-filtered mip chain.
+    fn upload(dev: &wgpu::Device, queue: &wgpu::Queue, width: u32, height: u32, rgba: &[u8]) -> Option<(wgpu::Texture, wgpu::TextureView)> {
+        if width == 0 || height == 0 || rgba.len() != (width * height * 4) as usize {
+            return None;
+        }
+        let mips = look_surface::mip_chain(width, height, rgba);
+        let t = dev.create_texture(&wgpu::TextureDescriptor {
+            label: Some("evani.model.look_map"),
+            size: wgpu::Extent3d { width, height, depth_or_array_layers: 1 },
+            mip_level_count: mips.len() as u32,
+            sample_count: 1,
+            dimension: wgpu::TextureDimension::D2,
+            format: wgpu::TextureFormat::Rgba8Unorm,
+            usage: wgpu::TextureUsages::TEXTURE_BINDING | wgpu::TextureUsages::COPY_DST,
+            view_formats: &[],
+        });
+        for (level, (w, h, data)) in mips.iter().enumerate() {
+            queue.write_texture(
+                wgpu::TexelCopyTextureInfo { texture: &t, mip_level: level as u32, origin: wgpu::Origin3d::ZERO, aspect: wgpu::TextureAspect::All },
+                data,
+                wgpu::TexelCopyBufferLayout { offset: 0, bytes_per_row: Some(w * 4), rows_per_image: Some(*h) },
+                wgpu::Extent3d { width: *w, height: *h, depth_or_array_layers: 1 },
+            );
+        }
+        let v = t.create_view(&wgpu::TextureViewDescriptor::default());
+        Some((t, v))
+    }
+
+    impl ModelGpu {
+        /// Ask the active look for its detail and clump maps (once).
+        pub(super) fn look_maps(&mut self, dev: &wgpu::Device, queue: &wgpu::Queue, world: &World) {
+            if self.look.tried {
+                return;
+            }
+            self.look.tried = true;
+            let Some(look) = world.try_res::<LookData>() else {
+                return;
+            };
+            let make = |name: &str| {
+                let req = GenRequest { name: name.to_owned(), size: SURFACE_MAP_SIZE, seed: 1, params: Default::default() };
+                match look.generate(&req) {
+                    Some(GeneratedAsset::Texture { width, height, rgba8 }) => upload(dev, queue, width, height, &rgba8),
+                    _ => None,
+                }
+            };
+            self.look.detail = make(DETAIL_GENERATOR);
+            self.look.clump = make(CLUMP_GENERATOR);
+        }
+
+        /// One material's lit bind group and its `ModelSurface` buffer.
+        pub(super) fn look_group(
+            &self,
+            dev: &wgpu::Device,
+            queue: &wgpu::Queue,
+            ub: &wgpu::Buffer,
+            m: &ModelMaterial,
+            views: &[Option<wgpu::TextureView>],
+        ) -> (wgpu::BindGroup, wgpu::Buffer) {
+            let white = &self.defaults[0].1;
+            let view = |k: usize, d: usize| m.maps[k].and_then(|i| views.get(i)).and_then(Option::as_ref).unwrap_or(&self.defaults[d].1);
+            let lit = |k: usize| m.surface.maps[k].and_then(|i| views.get(i)).and_then(Option::as_ref).unwrap_or(white);
+            let mut words = m.surface.words;
+            if self.look.detail.is_none() {
+                // No detail map from the look: the layer stays off.
+                words[11] = 0.0;
+            }
+            let sb = dev.create_buffer(&wgpu::BufferDescriptor {
+                label: Some("evani.model.surface"),
+                size: (SURFACE_WORDS * 4) as u64,
+                usage: wgpu::BufferUsages::UNIFORM | wgpu::BufferUsages::COPY_DST,
+                mapped_at_creation: false,
+            });
+            queue.write_buffer(&sb, 0, bytemuck::cast_slice(&words));
+            let detail = self.look.detail.as_ref().map_or(white, |d| &d.1);
+            let clump = self.look.clump.as_ref().map_or(white, |c| &c.1);
+            let g = dev.create_bind_group(&wgpu::BindGroupDescriptor {
+                label: Some("evani.model.material_lit"),
+                layout: &self.layout,
+                entries: &[
+                    wgpu::BindGroupEntry { binding: 0, resource: ub.as_entire_binding() },
+                    wgpu::BindGroupEntry { binding: 1, resource: wgpu::BindingResource::TextureView(view(0, 0)) },
+                    wgpu::BindGroupEntry { binding: 2, resource: wgpu::BindingResource::TextureView(view(1, 1)) },
+                    wgpu::BindGroupEntry { binding: 3, resource: wgpu::BindingResource::TextureView(view(2, 0)) },
+                    wgpu::BindGroupEntry { binding: 4, resource: wgpu::BindingResource::Sampler(&self.sampler) },
+                    wgpu::BindGroupEntry { binding: 5, resource: wgpu::BindingResource::TextureView(lit(0)) },
+                    wgpu::BindGroupEntry { binding: 6, resource: wgpu::BindingResource::TextureView(lit(1)) },
+                    wgpu::BindGroupEntry { binding: 7, resource: wgpu::BindingResource::TextureView(detail) },
+                    wgpu::BindGroupEntry { binding: 8, resource: sb.as_entire_binding() },
+                    wgpu::BindGroupEntry { binding: 9, resource: wgpu::BindingResource::TextureView(clump) },
+                ],
+            });
+            (g, sb)
+        }
+    }
+}
