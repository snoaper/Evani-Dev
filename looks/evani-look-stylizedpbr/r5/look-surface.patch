@@ -0,0 +1,222 @@
+//! Lit model shading and soft shadows (features `look-surface` and
+//! `soft-shadows`; CORE_REQUESTS `smooth-lighting` and `soft-shadows`).
+//!
+//! * `look-surface`: the model pipeline draws with `model_lit_vs` /
+//!   `model_lit_fs` (shaders/look_surface.wgsl, appended after model.wgsl in
+//!   the forward module), which read the glTF metallicRoughness and
+//!   occlusion maps (material group bindings 5 and 6), a per-material
+//!   `ModelSurface` uniform (binding 8, [`SurfaceMaterial::words`]) and two
+//!   look-supplied tiling maps: the detail weave (binding 7, generator
+//!   [`DETAIL_GENERATOR`]) and the fur clump map (binding 9, generator
+//!   [`CLUMP_GENERATOR`]). A look without those generators gets white maps
+//!   and the material flags keep both layers off.
+//! * `soft-shadows`: the forward module's shadow lookup is
+//!   shaders/soft_shadows.wgsl (PCSS: blocker search, penumbra from the
+//!   light size, filtered compare) in place of forward_shadows.wgsl. Same
+//!   bindings, same `shadow_vis` signature.
+//! * Both declare the slots their WGSL calls ([`declare`]); the look that
+//!   wants them (`stylizedpbr`) sets the bodies. The defaults shade like the
+//!   engine without the feature: no specular, no extra occlusion, the
+//!   tier's PCF radius.
+//!
+//! Games that turn neither feature on compile none of this.
+
+use evani_core::slots::{ShaderSlots, SlotSignature};
+
+/// Look generator for the biplanar detail map (RGBA8, R brightness and G
+/// height around 0.5, tiling). Sampled as linear data.
+pub const DETAIL_GENERATOR: &str = "surface.detail";
+/// Look generator for the fur clump map (RGBA8, R strand height, G clump
+/// shade, B noise, tiling). Sampled as linear data.
+pub const CLUMP_GENERATOR: &str = "surface.clump";
+/// Edge length asked of both generators.
+pub const SURFACE_MAP_SIZE: u32 = 256;
+
+/// Specular light from the sun for one pixel (zero by default).
+#[cfg(feature = "look-surface")]
+pub const SPECULAR: SlotSignature = SlotSignature {
+    name: "specular",
+    params: &[("n_dot_h", "f32"), ("n_dot_l", "f32"), ("n_dot_v", "f32"), ("roughness", "f32"), ("metal", "f32"), ("base", "vec3<f32>")],
+    ret: "vec3<f32>",
+    description: "Specular reflection of the sun from N.H, N.L, N.V, roughness, metalness and the base colour (zero = none)",
+    default_body: "    return vec3<f32>(0.0);",
+};
+
+/// Surface constants by index (0 occlusion/reflections, 1 detail, 2 sky
+/// tint, 3 ground tint).
+#[cfg(feature = "look-surface")]
+pub const SURFACE_PARAMS: SlotSignature = SlotSignature {
+    name: "surface_params",
+    params: &[("i", "u32")],
+    ret: "vec4<f32>",
+    description: "Model surface constants by index: 0 occlusion/reflections, 1 detail, 2 sky tint, 3 ground tint",
+    default_body: "    switch i {\n        case 0u: { return vec4<f32>(0.0, 0.0, 0.0, 0.0); }\n        case 1u: { return vec4<f32>(0.0, 0.05, 0.0, 0.0); }\n        default: { return vec4<f32>(1.0, 1.0, 1.0, 0.0); }\n    }",
+};
+
+/// Soft-shadow constants (penumbra per metre, search radius, min and max
+/// filter radius in texels).
+#[cfg(feature = "soft-shadows")]
+pub const PCSS_PARAMS: SlotSignature = SlotSignature {
+    name: "pcss_params",
+    params: &[("i", "u32")],
+    ret: "vec4<f32>",
+    description: "Soft shadows: penumbra per metre, search radius, min and max filter radius (texels)",
+    default_body: "    return vec4<f32>(0.02, 6.0, 1.0, 12.0);",
+};
+
+/// Declare the slots this build's forward WGSL calls (idempotent: a look
+/// that declared them first keeps its bodies).
+pub fn declare(slots: &mut ShaderSlots) {
+    #[cfg(feature = "look-surface")]
+    {
+        slots.declare(SPECULAR);
+        slots.declare(SURFACE_PARAMS);
+    }
+    #[cfg(feature = "soft-shadows")]
+    slots.declare(PCSS_PARAMS);
+}
+
+/// Words in the `ModelSurface` uniform (group 1, binding 8).
+#[cfg(feature = "look-surface")]
+pub const SURFACE_WORDS: usize = 16;
+
+/// A material's lit-shading data beside [`crate::model::ModelMaterial`].
+#[cfg(feature = "look-surface")]
+#[derive(Clone, Debug, PartialEq)]
+pub struct SurfaceMaterial {
+    /// `ModelSurface`: [metal, rough, occlusion strength, fur flag],
+    /// [fur length m, density, shells drawn (0 = clump-map fallback), clump
+    /// scale m], [tip linear rgb, detail flag], [detail tile m, strength, 0, 0].
+    pub words: [f32; SURFACE_WORDS],
+    /// Metallic-roughness and occlusion maps: indices into
+    /// [`crate::model::Prepared::textures`].
+    pub maps: [Option<usize>; 2],
+}
+
+#[cfg(feature = "look-surface")]
+fn srgb_to_linear(c: f64) -> f32 {
+    let v = (c / 255.0).clamp(0.0, 1.0) as f32;
+    if v <= 0.04045 { v / 12.92 } else { ((v + 0.055) / 1.055).powf(2.4) }
+}
+
+/// The words for one material: glTF factors, `extras.evani_fur`
+/// (`length_m`, `density`, `shells`, `clump_scale_m`, `tip` sRGB 0-255) and
+/// `extras.evani_detail` (`scale_m`, `strength`). Out-of-range or malformed
+/// extras leave that layer off. Shells are always 0 here: the forward path
+/// draws no shells yet (CORE_REQUESTS `fur-shells`), so fur shades with the
+/// clump-map fallback on every tier.
+#[cfg(feature = "look-surface")]
+pub fn surface_words(metallic: f32, roughness: f32, occlusion_strength: f32, extras: &serde_json::Value) -> [f32; SURFACE_WORDS] {
+    let mut w = [0.0f32; SURFACE_WORDS];
+    w[0] = metallic.clamp(0.0, 1.0);
+    w[1] = roughness.clamp(0.0, 1.0);
+    w[2] = occlusion_strength.clamp(0.0, 1.0);
+    let num = |o: &serde_json::Value, k: &str| o.get(k).and_then(serde_json::Value::as_f64);
+    if let Some(f) = extras.get("evani_fur") {
+        let tip: Option<Vec<f64>> = f.get("tip").and_then(serde_json::Value::as_array).and_then(|a| a.iter().map(serde_json::Value::as_f64).collect());
+        if let (Some(len), Some(den), Some(clump), Some(tip)) = (num(f, "length_m"), num(f, "density"), num(f, "clump_scale_m"), tip)
+            && len > 0.0
+            && len <= 0.2
+            && den > 0.0
+            && clump > 0.0
+            && clump <= 1.0
+            && tip.len() == 3
+        {
+            w[3] = 1.0;
+            w[4] = len as f32;
+            w[5] = den as f32;
+            w[6] = 0.0;
+            w[7] = clump as f32;
+            for (k, c) in tip.iter().enumerate() {
+                w[8 + k] = srgb_to_linear(*c);
+            }
+        }
+    }
+    if let Some(d) = extras.get("evani_detail") {
+        let scale = num(d, "scale_m").unwrap_or(0.0);
+        let strength = num(d, "strength").unwrap_or(1.0);
+        if (0.0..=10.0).contains(&scale) && (0.0..=1.0).contains(&strength) {
+            w[11] = 1.0;
+            w[12] = scale as f32;
+            w[13] = strength as f32;
+        }
+    }
+    w
+}
+
+/// A box-filtered mip chain of a tiling RGBA8 image (level 0 first; odd
+/// edges round down, the last level is 1 x 1).
+#[cfg(feature = "look-surface")]
+pub fn mip_chain(width: u32, height: u32, rgba: &[u8]) -> Vec<(u32, u32, Vec<u8>)> {
+    let mut out = vec![(width, height, rgba.to_vec())];
+    while let Some((w, h, src)) = out.last() {
+        let (w, h) = (*w, *h);
+        if w <= 1 && h <= 1 {
+            break;
+        }
+        let (nw, nh) = ((w / 2).max(1), (h / 2).max(1));
+        let mut dst = vec![0u8; (nw * nh * 4) as usize];
+        for y in 0..nh {
+            for x in 0..nw {
+                for c in 0..4 {
+                    let mut sum = 0u32;
+                    for (dx, dy) in [(0, 0), (1, 0), (0, 1), (1, 1)] {
+                        let sx = (x * 2 + dx).min(w - 1);
+                        let sy = (y * 2 + dy).min(h - 1);
+                        sum += u32::from(src.get(((sy * w + sx) * 4 + c) as usize).copied().unwrap_or(0));
+                    }
+                    dst[((y * nw + x) * 4 + c) as usize] = ((sum + 2) / 4) as u8;
+                }
+            }
+        }
+        out.push((nw, nh, dst));
+    }
+    out
+}
+
+#[cfg(all(test, feature = "look-surface"))]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn fur_and_detail_extras_fill_the_words() {
+        let e = serde_json::json!({
+            "evani_fur": {"length_m": 0.01, "density": 120.0, "shells": 8, "clump_scale_m": 0.012, "tip": [255, 128, 0]},
+            "evani_detail": {"scale_m": 0.02, "strength": 0.5}
+        });
+        let w = surface_words(0.2, 0.7, 1.0, &e);
+        assert_eq!(&w[..4], &[0.2, 0.7, 1.0, 1.0]);
+        assert_eq!(w[6], 0.0, "no shells in the forward path yet");
+        assert!((w[8] - 1.0).abs() < 1e-6 && w[10] == 0.0 && (w[9] - 0.2158).abs() < 1e-3);
+        assert_eq!(&w[11..14], &[1.0, 0.02, 0.5]);
+    }
+
