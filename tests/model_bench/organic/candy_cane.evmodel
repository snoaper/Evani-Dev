# Benchmark B, stylized organic 7 of 10: a candy cane planted in the ground.
make: candy_cane
style: toon_chunky
parts:
  shaft: { thick, straight }
  hook: { round, open: medium }
relief:
  shaft.outer: panel_lines(along, width 1cm, depth 3mm, pitch 12cm)
must:
  fit_box: [0.3, 0.9, 2.5] m
  stands: ground
  tri_budget: { low: 300, medium: 800, high: 2k, ultra: 6k }
match: { front: ../ref/candy_cane/front.png, side: ../ref/candy_cane/side.png }
explore: auto
return: 3
seed: 307
