# Benchmark B, hard-surface prop 6 of 10: a park bench with a slatted seat and back.
make: bench
style: toon_chunky
parts:
  seat: { slats: 4, slightly_curved }
  back: { slats: 3, reclined: slight }
  legs: { shape: frame, count: 2, chunky }
  armrests: { shape: curl }
relief:
  seat.faces: planks(straight, width 9cm, depth 2mm)
  legs.outer: hammered(depth 1mm)
must:
  fit_box: [0.65, 1.8, 0.9] m
  stands: ground
  min_size: { width: 1.6m, height: 0.8m }
  symmetric: x
  anchor: { name: seat_line, at: seat.top }
  tri_budget: { low: 500, medium: 1.2k, high: 3k, ultra: 9k }
match: { front: ../ref/bench/front.png, side: ../ref/bench/side.png }
explore: auto
return: 3
seed: 106
