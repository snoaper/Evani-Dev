# Benchmark B, vehicle 2 of 10: Sugarpeak Rally rival kart (Mo: tall and rounded).
# Reference: the base kart with this rival's shape overrides (manifest.json),
# made by the reference tool; if Chris picks option A (decision D4) the
# reference is the base kart for all eight.
make: kart
like: bench/kart_01_pip
style: toon_chunky
parts:
  chassis: { tall, rounded }
  nose: { shape: blunt, rounded }
  side_pods: { rounded }
relief:
  tyres.outer: tread(rib, depth 5mm, pitch 4cm)
must:
  wheels_clear_chassis_at_steer: 30 deg
  seats: bench/kart_driver
  symmetric: x
  tri_budget: { low: 3k, medium: 8k, high: 20k, ultra: 60k }
match: { side: ../ref/kart_02_mo/side.png, front: ../ref/kart_02_mo/front.png, top: ../ref/kart_02_mo/top.png, chase: ../ref/kart_02_mo/chase.png, mesh: ../ref/kart_02_mo/mesh.glb }
explore: auto
return: 3
seed: 202
