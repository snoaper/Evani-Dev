# Benchmark B, vehicle 6 of 10: Sugarpeak Rally rival kart (Nib: small and compact, short wheelbase).
# Reference: the base kart with this rival's shape overrides (manifest.json),
# made by the reference tool; if Chris picks option A (decision D4) the
# reference is the base kart for all eight.
make: kart
like: bench/kart_01_pip
style: toon_chunky
parts:
  chassis: { short, narrow }
  rear_tyres: { size: normal }
  wing: { small }
relief:
  tyres.outer: tread(rib, depth 4mm, pitch 3cm)
must:
  wheels_clear_chassis_at_steer: 30 deg
  seats: bench/kart_driver
  symmetric: x
  tri_budget: { low: 3k, medium: 8k, high: 20k, ultra: 60k }
match: { side: ../ref/kart_06_nib/side.png, front: ../ref/kart_06_nib/front.png, top: ../ref/kart_06_nib/top.png, chase: ../ref/kart_06_nib/chase.png, mesh: ../ref/kart_06_nib/mesh.glb }
explore: auto
return: 3
seed: 206
