    { "name": "kart-app-lap", "file": "apps/kart-racer/src/ui.rs",
      "from": "lap: format!(\"Lap {}/{}\", h.lap.clamp(1, h.laps.max(1)), h.laps),",
      "to": "lap: format!(\"LAP {}/{} ~\", h.lap.clamp(1, h.laps.max(1)), h.laps),", "expect": "patched" },
    { "name": "kart-compile-error", "file": "apps/kart-racer/src/ui.rs",
      "from": "lap: format!(\"Lap {}/{}\", h.lap.clamp(1, h.laps.max(1)), h.laps),",
      "to": "lap: format!(\"Lap {}/{}\", h.lap.clamp(1, h.laps.max(1)), h.lapz),", "expect": "error" }
  ]
